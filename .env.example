# ─────────────────────────────────────────────────────────────
#  Copy this file to .env and restart `npm run dev`.
#  Endpoint paths live in src/config/api.config.js.
# ─────────────────────────────────────────────────────────────

# Base URL of your backend, e.g. https://api.spotontop.com/v1
VITE_API_BASE_URL=

# true  = use the built-in demo data (no network calls)
# false = call the real API at VITE_API_BASE_URL
VITE_USE_DEMO_DATA=true

# Optional PUBLIC token, sent as "Authorization: Bearer <token>".
# Everything in this file is visible in the browser bundle:
# never put a Meta app secret or page access token here.
VITE_API_TOKEN=

# Set to true if your API authenticates with cookies on another domain.
VITE_API_WITH_CREDENTIALS=false
